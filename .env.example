# ==============================================================================
# Cloud-Based Recommendation Systems - Environment Configuration
# ==============================================================================

# Application & Security
PROJECT_NAME="Cloud-Based Recommendation Systems"
VERSION=1.0.0
JWT_SECRET=production-grade-super-secret-jwt-key-2026
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Primary Database (PostgreSQL)
# For local SQLite testing: sqlite:///./recommendation.db
# For Docker / Cloud: postgresql://postgres:postgrespassword@localhost:5432/recommendation_db
DATABASE_URL=sqlite:///./recommendation.db

# Cache Tier (Redis)
# Leave as redis://localhost:6379/0 or empty for graceful in-memory fallback
REDIS_URL=redis://localhost:6379/0
CACHE_EXPIRATION_SECONDS=3600

# Recommendation Engine Defaults
DEFAULT_CONTENT_WEIGHT=0.60
DEFAULT_COLLAB_WEIGHT=0.40

# Network & CORS
API_BASE_URL=http://localhost:8000
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173","*"]
